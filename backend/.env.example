# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database: TCB PostgreSQL (auto-configured by genie-tcb-db-integrator skill)
# Do NOT set DATABASE_URL manually

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ===== 大模型配置（OpenAI 兼容接口） =====
# 留空时服务进入“演示模式”，返回示例回复；填写后返回真实回复
AI_API_KEY=
# 可选：自定义接口地址，例如 DeepSeek 为 https://api.deepseek.com/v1
AI_BASE_URL=https://api.openai.com/v1
# 可选：模型名称，例如 deepseek-chat / gpt-4o-mini / gpt-4o
AI_MODEL=gpt-4o-mini
